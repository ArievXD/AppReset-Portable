<Application x:Class="AppReset.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:AppReset.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Replaced at startup and on a language switch by Loc.SetLanguage. -->
                <ResourceDictionary Source="Strings/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <infra:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <infra:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

            <!-- Paths are machine text people compare character by character, so they are
                 always set in a monospaced face. Cascadia Mono ships with Windows 11. -->
            <FontFamily x:Key="PathFont">Cascadia Mono, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
