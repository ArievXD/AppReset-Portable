<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- UI text (English). Keep the keys identical in every Strings.*.xaml file. -->
    <sys:String x:Key="App.Title">AppReset</sys:String>
    <sys:String x:Key="App.Tagline">Put a Windows app back to how it was the first time you opened it. The program stays installed.</sys:String>

    <sys:String x:Key="Settings.Language">Language</sys:String>
    <sys:String x:Key="Settings.Theme">Theme</sys:String>

    <sys:String x:Key="Lang.English">English</sys:String>
    <sys:String x:Key="Lang.Indonesian">Bahasa Indonesia</sys:String>

    <sys:String x:Key="Theme.System">Same as Windows</sys:String>
    <sys:String x:Key="Theme.Light">Light</sys:String>
    <sys:String x:Key="Theme.Dark">Dark</sys:String>

    <sys:String x:Key="Tab.Reset">Reset an app</sys:String>
    <sys:String x:Key="Tab.Backups">Backups</sys:String>

    <sys:String x:Key="Apps.Header">Installed apps</sys:String>
    <sys:String x:Key="Apps.Search">Search by name or publisher</sys:String>
    <sys:String x:Key="Apps.Count">{0} apps shown</sys:String>
    <sys:String x:Key="Apps.Loading">Reading the list of installed apps…</sys:String>
    <sys:String x:Key="Apps.Error">The list of installed apps could not be read. {0}</sys:String>
    <sys:String x:Key="Apps.Retry">Try again</sys:String>
    <sys:String x:Key="Apps.NoMatch">No installed app matches “{0}”.</sys:String>
    <sys:String x:Key="Apps.Reload">Reload list</sys:String>

    <sys:String x:Key="Empty.Title">Pick an app on the left</sys:String>
    <sys:String x:Key="Empty.Body">AppReset looks for the settings and data that app keeps in your Windows user folders and registry. You choose what to remove, a backup is saved first, and the app opens like it did on day one.</sys:String>
    <sys:String x:Key="Empty.Limits">Only standard Windows data locations are checked. Accounts, licenses and anything stored online or in other folders are not touched.</sys:String>
    <sys:String x:Key="Empty.Store">Apps from the Microsoft Store already have this built in: Settings, Apps, Installed apps, Advanced options, Reset.</sys:String>

    <sys:String x:Key="Detail.Version">version {0}</sys:String>
    <sys:String x:Key="Detail.InstalledIn">Installed in</sys:String>

    <sys:String x:Key="Running.Message">{0} is open ({1}). Close it first, otherwise files it is using cannot be removed.</sys:String>
    <sys:String x:Key="Running.Check">Check again</sys:String>

    <sys:String x:Key="Admin.Message">{0} of the items found are shared by every user on this PC. Changing them needs administrator rights.</sys:String>
    <sys:String x:Key="Admin.Restart">Restart as administrator</sys:String>

    <sys:String x:Key="Scan.Working">Looking in AppData, ProgramData and the registry…</sys:String>
    <sys:String x:Key="Scan.Error">The scan stopped. {0}</sys:String>
    <sys:String x:Key="Scan.Again">Scan again</sys:String>
    <sys:String x:Key="Scan.NothingTitle">Nothing found for {0}</sys:String>
    <sys:String x:Key="Scan.NothingBody">No folder or registry key in the standard locations matches this app. It may keep its data somewhere else, or it has not saved anything yet.</sys:String>
    <sys:String x:Key="Scan.FoundIntro">Ticked items will be removed. Exact matches are ticked for you. Check the others before ticking them.</sys:String>

    <sys:String x:Key="Location.RoamingAppData">Settings in AppData\Roaming</sys:String>
    <sys:String x:Key="Location.LocalAppData">Data and cache in AppData\Local</sys:String>
    <sys:String x:Key="Location.LocalLowAppData">Data in AppData\LocalLow</sys:String>
    <sys:String x:Key="Location.ProgramData">Shared data in ProgramData</sys:String>
    <sys:String x:Key="Location.UserRegistry">Your registry settings</sys:String>
    <sys:String x:Key="Location.MachineRegistry">PC-wide registry settings</sys:String>

    <sys:String x:Key="Strength.Exact">Exact match</sys:String>
    <sys:String x:Key="Strength.Likely">Likely match</sys:String>
    <sys:String x:Key="Strength.Possible">Possible match</sys:String>

    <sys:String x:Key="Reason.NameExact">The name is the app's name</sys:String>
    <sys:String x:Key="Reason.ExeName">The name is the app's program file name. Make sure it belongs to this app</sys:String>
    <sys:String x:Key="Reason.NameSimilar">The name is close to the app's name. It may belong to a related app</sys:String>
    <sys:String x:Key="Reason.NameContains">The name contains the app's name. Check before removing</sys:String>
    <sys:String x:Key="Reason.InsidePublisherFolder">Inside the publisher's folder, named after the app</sys:String>
    <sys:String x:Key="Reason.PublisherFolder">The whole publisher folder. No other app from this publisher is installed</sys:String>

    <sys:String x:Key="Warn.MachineWide">Shared by every user on this PC.</sys:String>
    <sys:String x:Key="Warn.MachineRegistry">Usually written by the installer. Removing it can stop the app from starting.</sys:String>

    <sys:String x:Key="Item.NeedsAdmin">Needs administrator rights</sys:String>
    <sys:String x:Key="Item.Open">Open</sys:String>
    <sys:String x:Key="Item.OpenName">Open {0} in File Explorer</sys:String>
    <sys:String x:Key="Item.SizeUnknown">size unknown</sys:String>

    <sys:String x:Key="Footer.Backup">Save a backup first (recommended)</sys:String>
    <sys:String x:Key="Footer.Selected">{0} selected, {1}</sys:String>
    <sys:String x:Key="Footer.SelectedNone">Nothing selected</sys:String>
    <sys:String x:Key="Footer.Reset">Reset {0}</sys:String>

    <sys:String x:Key="Progress.Step">Item {0} of {1}</sys:String>

    <sys:String x:Key="Confirm.Title">Reset {0}?</sys:String>
    <sys:String x:Key="Confirm.WithBackup">{0} items ({1}) will be removed. A backup is saved first, so you can undo this from the Backups tab.</sys:String>
    <sys:String x:Key="Confirm.NoBackup">{0} items ({1}) will be removed without a backup. This cannot be undone.</sys:String>
    <sys:String x:Key="Confirm.Continue">Continue?</sys:String>

    <sys:String x:Key="Result.ResetTitle">Reset finished</sys:String>
    <sys:String x:Key="Result.ResetErrorTitle">Reset stopped</sys:String>
    <sys:String x:Key="Result.RestoreTitle">Restore finished</sys:String>
    <sys:String x:Key="Result.RestoreErrorTitle">Restore stopped</sys:String>
    <sys:String x:Key="Result.Removed">{0} of {1} items removed.</sys:String>
    <sys:String x:Key="Result.BackupSaved">A backup was saved.</sys:String>
    <sys:String x:Key="Result.NoBackup">No backup was made.</sys:String>
    <sys:String x:Key="Result.Restored">{0} of {1} items put back for {2}.</sys:String>
    <sys:String x:Key="Result.NextStep">Open {0} to check that it starts like a fresh install.</sys:String>
    <sys:String x:Key="Result.NotRemoved">Not removed</sys:String>
    <sys:String x:Key="Result.NotRestored">Not put back</sys:String>
    <sys:String x:Key="Result.OpenBackup">Open backup folder</sys:String>
    <sys:String x:Key="Result.Unexpected">Something went wrong: {0}</sys:String>

    <sys:String x:Key="Failure.Blocked">Refused by AppReset's safety rules.</sys:String>
    <sys:String x:Key="Failure.InUse">A file is in use by another program.</sys:String>
    <sys:String x:Key="Failure.AccessDenied">Windows denied access.</sys:String>
    <sys:String x:Key="Failure.NeedsAdmin">Needs administrator rights.</sys:String>
    <sys:String x:Key="Failure.ContainsLink">Contains a link to another folder, so it was left alone.</sys:String>
    <sys:String x:Key="Failure.MissingFromBackup">The saved copy is missing from the backup.</sys:String>
    <sys:String x:Key="Failure.Other">Something went wrong.</sys:String>
    <sys:String x:Key="Failure.LeftInPlace">It could not be backed up, so it was left in place.</sys:String>

    <sys:String x:Key="Backups.Intro">Every reset saves a copy here first. Restoring a backup puts that app's data back exactly as it was before the reset.</sys:String>
    <sys:String x:Key="Backups.Folder">Saved in</sys:String>
    <sys:String x:Key="Backups.OpenFolder">Open backup folder</sys:String>
    <sys:String x:Key="Backups.Refresh">Refresh</sys:String>
    <sys:String x:Key="Backups.Loading">Reading backups…</sys:String>
    <sys:String x:Key="Backups.Error">Backups could not be read. {0}</sys:String>
    <sys:String x:Key="Backups.EmptyTitle">No backups yet</sys:String>
    <sys:String x:Key="Backups.EmptyBody">A backup appears here each time you reset an app with “Save a backup first” ticked.</sys:String>
    <sys:String x:Key="Backups.Meta">{0}, {1} items, {2}</sys:String>
    <sys:String x:Key="Backups.NeedsAdmin">Some items are PC-wide and need administrator rights to restore.</sys:String>
    <sys:String x:Key="Backups.Restore">Restore</sys:String>
    <sys:String x:Key="Backups.OpenOne">Open</sys:String>
    <sys:String x:Key="Backups.Delete">Delete</sys:String>
    <sys:String x:Key="Backups.RestoreTitle">Restore {0}?</sys:String>
    <sys:String x:Key="Backups.RestoreConfirm">The data {0} has now is replaced by the copy saved on {1}. Close {0} before continuing.</sys:String>
    <sys:String x:Key="Backups.DeleteTitle">Delete backup of {0}?</sys:String>
    <sys:String x:Key="Backups.DeleteConfirm">The backup of {0} from {1} is deleted for good. You will not be able to restore it afterwards.</sys:String>
    <sys:String x:Key="Backups.DeleteFailed">The backup could not be deleted. {0}</sys:String>
</ResourceDictionary>
