    <sys:String x:Key="Reason.NameSimilar">Namanya mirip nama aplikasi. Bisa jadi milik aplikasi lain yang terkait</sys:String>
    <sys:String x:Key="Reason.NameContains">Namanya mengandung nama aplikasi. Periksa sebelum menghapus</sys:String>
    <sys:String x:Key="Reason.InsidePublisherFolder">Di dalam folder penerbit, dinamai sesuai aplikasi</sys:String>
    <sys:String x:Key="Reason.PublisherFolder">Seluruh folder penerbit. Tidak ada aplikasi lain dari penerbit ini yang terpasang</sys:String>

    <sys:String x:Key="Warn.MachineWide">Dipakai bersama oleh semua pengguna di PC ini.</sys:String>
    <sys:String x:Key="Warn.MachineRegistry">Biasanya ditulis oleh installer. Menghapusnya bisa membuat aplikasi gagal terbuka.</sys:String>

    <sys:String x:Key="Item.NeedsAdmin">Butuh hak administrator</sys:String>
    <sys:String x:Key="Item.Open">Buka</sys:String>
    <sys:String x:Key="Item.OpenName">Buka {0} di File Explorer</sys:String>
    <sys:String x:Key="Item.SizeUnknown">ukuran tidak diketahui</sys:String>

    <sys:String x:Key="Footer.Backup">Simpan cadangan dulu (disarankan)</sys:String>
    <sys:String x:Key="Footer.Selected">{0} dipilih, {1}</sys:String>
    <sys:String x:Key="Footer.SelectedNone">Belum ada yang dipilih</sys:String>
    <sys:String x:Key="Footer.Reset">Reset {0}</sys:String>

    <sys:String x:Key="Progress.Step">Item {0} dari {1}</sys:String>

    <sys:String x:Key="Confirm.Title">Reset {0}?</sys:String>
