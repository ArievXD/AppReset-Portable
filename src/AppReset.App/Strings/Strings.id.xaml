    <sys:String x:Key="Backups.DeleteTitle">Hapus cadangan {0}?</sys:String>
    <sys:String x:Key="Backups.DeleteConfirm">Cadangan {0} dari {1} akan dihapus permanen dan tidak bisa dipulihkan lagi.</sys:String>
    <sys:String x:Key="Backups.DeleteFailed">Cadangan tidak bisa dihapus. {0}</sys:String>
</ResourceDictionary>
