    <sys:String x:Key="Confirm.NoBackup">{0} item ({1}) akan dihapus tanpa cadangan. Ini tidak bisa dibatalkan.</sys:String>
    <sys:String x:Key="Confirm.Continue">Lanjutkan?</sys:String>

    <sys:String x:Key="Result.ResetTitle">Reset selesai</sys:String>
    <sys:String x:Key="Result.ResetErrorTitle">Reset berhenti</sys:String>
    <sys:String x:Key="Result.RestoreTitle">Pemulihan selesai</sys:String>
    <sys:String x:Key="Result.RestoreErrorTitle">Pemulihan berhenti</sys:String>
    <sys:String x:Key="Result.Removed">{0} dari {1} item dihapus.</sys:String>
    <sys:String x:Key="Result.BackupSaved">Cadangan sudah disimpan.</sys:String>
    <sys:String x:Key="Result.NoBackup">Tidak ada cadangan yang dibuat.</sys:String>
    <sys:String x:Key="Result.Restored">{0} dari {1} item milik {2} dikembalikan.</sys:String>
    <sys:String x:Key="Result.NextStep">Buka {0} untuk memastikan aplikasinya terbuka seperti baru dipasang.</sys:String>
    <sys:String x:Key="Result.NotRemoved">Tidak terhapus</sys:String>
    <sys:String x:Key="Result.NotRestored">Tidak dikembalikan</sys:String>
    <sys:String x:Key="Result.OpenBackup">Buka folder cadangan</sys:String>
    <sys:String x:Key="Result.Unexpected">Terjadi kesalahan: {0}</sys:String>

    <sys:String x:Key="Failure.Blocked">Ditolak oleh aturan keamanan AppReset.</sys:String>
    <sys:String x:Key="Failure.InUse">Ada file yang sedang dipakai program lain.</sys:String>
    <sys:String x:Key="Failure.AccessDenied">Windows menolak akses.</sys:String>
    <sys:String x:Key="Failure.NeedsAdmin">Butuh hak administrator.</sys:String>
    <sys:String x:Key="Failure.ContainsLink">Berisi tautan ke folder lain, jadi dibiarkan.</sys:String>
    <sys:String x:Key="Failure.MissingFromBackup">Salinan yang disimpan tidak ada di cadangan.</sys:String>
    <sys:String x:Key="Failure.Other">Terjadi kesalahan.</sys:String>
    <sys:String x:Key="Failure.LeftInPlace">Item ini gagal dicadangkan, jadi tidak dihapus.</sys:String>

    <sys:String x:Key="Backups.Intro">Setiap reset menyimpan salinan di sini lebih dulu. Memulihkan cadangan mengembalikan data aplikasi itu persis seperti sebelum direset.</sys:String>
    <sys:String x:Key="Backups.Folder">Disimpan di</sys:String>
    <sys:String x:Key="Backups.OpenFolder">Buka folder cadangan</sys:String>
    <sys:String x:Key="Backups.Refresh">Muat ulang</sys:String>
    <sys:String x:Key="Backups.Loading">Membaca cadangan…</sys:String>
    <sys:String x:Key="Backups.Error">Cadangan tidak bisa dibaca. {0}</sys:String>
    <sys:String x:Key="Backups.EmptyTitle">Belum ada cadangan</sys:String>
    <sys:String x:Key="Backups.EmptyBody">Cadangan muncul di sini setiap kali kamu mereset aplikasi dengan “Simpan cadangan dulu” dicentang.</sys:String>
    <sys:String x:Key="Backups.Meta">{0}, {1} item, {2}</sys:String>
