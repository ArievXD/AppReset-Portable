    <sys:String x:Key="Scan.Again">Pindai ulang</sys:String>
    <sys:String x:Key="Scan.NothingTitle">Tidak ada data untuk {0}</sys:String>
    <sys:String x:Key="Scan.NothingBody">Tidak ada folder atau kunci registry di lokasi standar yang cocok dengan aplikasi ini. Mungkin datanya disimpan di tempat lain, atau aplikasi belum menyimpan apa pun.</sys:String>
    <sys:String x:Key="Scan.FoundIntro">Item yang dicentang akan dihapus. Yang cocok persis sudah dicentang. Periksa yang lain sebelum mencentangnya.</sys:String>

    <sys:String x:Key="Location.RoamingAppData">Pengaturan di AppData\Roaming</sys:String>
    <sys:String x:Key="Location.LocalAppData">Data dan cache di AppData\Local</sys:String>
    <sys:String x:Key="Location.LocalLowAppData">Data di AppData\LocalLow</sys:String>
    <sys:String x:Key="Location.ProgramData">Data bersama di ProgramData</sys:String>
    <sys:String x:Key="Location.UserRegistry">Pengaturan registry milikmu</sys:String>
    <sys:String x:Key="Location.MachineRegistry">Pengaturan registry untuk seluruh PC</sys:String>

    <sys:String x:Key="Strength.Exact">Cocok persis</sys:String>
    <sys:String x:Key="Strength.Likely">Kemungkinan besar cocok</sys:String>
    <sys:String x:Key="Strength.Possible">Mungkin cocok</sys:String>

    <sys:String x:Key="Reason.NameExact">Namanya sama dengan nama aplikasi</sys:String>
