<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- UI text (Bahasa Indonesia). Keep the keys identical in every Strings.*.xaml file. -->
    <sys:String x:Key="App.Title">AppReset</sys:String>
    <sys:String x:Key="App.Tagline">Kembalikan aplikasi Windows seperti saat pertama kali dibuka. Programnya tetap terpasang.</sys:String>

    <sys:String x:Key="Settings.Language">Bahasa</sys:String>
    <sys:String x:Key="Settings.Theme">Tema</sys:String>

    <sys:String x:Key="Lang.English">English</sys:String>
    <sys:String x:Key="Lang.Indonesian">Bahasa Indonesia</sys:String>

    <sys:String x:Key="Theme.System">Ikuti Windows</sys:String>
    <sys:String x:Key="Theme.Light">Terang</sys:String>
    <sys:String x:Key="Theme.Dark">Gelap</sys:String>

    <sys:String x:Key="Tab.Reset">Reset aplikasi</sys:String>
    <sys:String x:Key="Tab.Backups">Cadangan</sys:String>

    <sys:String x:Key="Apps.Header">Aplikasi terpasang</sys:String>
    <sys:String x:Key="Apps.Search">Cari nama atau penerbit</sys:String>
    <sys:String x:Key="Apps.Count">{0} aplikasi ditampilkan</sys:String>
