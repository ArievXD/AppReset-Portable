<Window x:Class="AppReset.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppReset.App.ViewModels"
        Title="{DynamicResource App.Title}"
        Icon="Assets/AppReset.ico"
        Width="1080" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PathFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CautionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Banners: caution for "check this first", neutral for information. -->
        <Style x:Key="CautionBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource CautionBanner}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <!-- Green when everything worked, amber when something was left behind. -->
        <Style x:Key="ResultBanner" TargetType="Border" BasedOn="{StaticResource CautionBanner}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClean}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type vm:ResultViewModel}">
            <Border Style="{StaticResource ResultBanner}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding NextStep, Converter={StaticResource NotEmptyToVisibility}}" />

                    <StackPanel Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding FailuresHeader}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Failures}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FailureLine}">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource PathText}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Content="{DynamicResource Result.OpenBackup}"
                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding BackupFolder}"
                            Visibility="{Binding BackupFolder, Converter={StaticResource NotEmptyToVisibility}}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: name, what it does, language and theme. -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom" Margin="0,0,24,0">
                <TextBlock Text="{DynamicResource App.Title}" Style="{DynamicResource TitleTextBlockStyle}" />
                <TextBlock Text="{DynamicResource App.Tagline}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,12,0">
                    <Label Content="{DynamicResource Settings.Language}" Target="{Binding ElementName=LanguageBox}" Padding="0,0,0,4" />
                    <ComboBox x:Name="LanguageBox" MinWidth="160"
                              ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>
                <StackPanel>
                    <Label Content="{DynamicResource Settings.Theme}" Target="{Binding ElementName=ThemeBox}" Padding="0,0,0,4" />
                    <ComboBox x:Name="ThemeBox" MinWidth="160"
                              ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,8,0,0">

            <!-- ============================================================ Reset tab -->
            <TabItem Header="{DynamicResource Tab.Reset}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Installed apps -->
                    <DockPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Apps.Header}"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <Label DockPanel.Dock="Top" Content="{DynamicResource Apps.Search}"
                               Target="{Binding ElementName=SearchBox}" Padding="0" Margin="0,10,0,4" />
                        <TextBox DockPanel.Dock="Top" x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Apps.Reload}"
                                    Command="{Binding ReloadAppsCommand}" />
                            <TextBlock Text="{Binding AppCountText}" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AppsState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Ready}" />
                        </DockPanel>

                        <Grid Margin="0,8,0,0">
                            <ListBox ItemsSource="{Binding VisibleApps}"
                                     SelectedItem="{Binding SelectedApp}"
                                     AutomationProperties.Name="{DynamicResource Apps.Header}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding AppsState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Ready}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding NoMatchText}" Style="{StaticResource SecondaryText}" Margin="4,8"
                                       Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Margin="4,8"
                                        Visibility="{Binding AppsState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Loading}">
                                <ProgressBar IsIndeterminate="True" Height="4" />
                                <TextBlock Text="{DynamicResource Apps.Loading}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Margin="4,8"
                                        Visibility="{Binding AppsState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Error}">
                                <TextBlock Text="{Binding AppsError}" TextWrapping="Wrap" />
                                <Button Content="{DynamicResource Apps.Retry}" Command="{Binding ReloadAppsCommand}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <Border Grid.Column="1" Width="1" Margin="20,0"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- Nothing selected yet -->
                    <StackPanel Grid.Column="2" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{DynamicResource Empty.Title}" Style="{DynamicResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{DynamicResource Empty.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource Empty.Limits}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
                        <TextBlock Text="{DynamicResource Empty.Store}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Selected app -->
                    <DockPanel Grid.Column="2"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding SelectedApp.Name}" Style="{DynamicResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedApp.Meta}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedApp.InstallLocation, Converter={StaticResource NotEmptyToVisibility}}">
                                <Run Text="{DynamicResource Detail.InstalledIn}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding SelectedApp.InstallLocation, Mode=OneWay}" FontFamily="{StaticResource PathFont}" FontSize="12.5" />
                            </TextBlock>
                        </StackPanel>

                        <!-- The app is open: removing files would fail half way. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource CautionBanner}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Running.Check}"
                                        Command="{Binding CheckRunningCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RunningText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        Content="{Binding ResetResult}" ContentTemplate="{StaticResource ResultTemplate}"
                                        Visibility="{Binding ResetResult, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}"
                                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Admin.Restart}"
                                        Command="{Binding RestartAsAdminCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AdminText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Footer: the one decision on this screen. -->
                        <Border DockPanel.Dock="Bottom" Padding="0,14,0,0" Margin="0,8,0,0" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <CheckBox Content="{DynamicResource Footer.Backup}" IsChecked="{Binding MakeBackup}"
                                              IsEnabled="{Binding IsIdle}" />
                                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ResetCommand}"
                                        AutomationProperties.Name="{Binding ResetButtonText}"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        MinHeight="40" MinWidth="140" MaxWidth="320" Padding="20,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResetButtonText}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Progress while backing up and removing. -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                    Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding ProgressMaximum}" Height="4" />
                            <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ProgressPath}" Style="{StaticResource PathText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Scan results and their states. -->
                        <Grid Margin="0,16,0,0">
                            <StackPanel Visibility="{Binding ScanState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Scanning}">
                                <ProgressBar IsIndeterminate="True" Height="4" />
                                <TextBlock Text="{DynamicResource Scan.Working}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ScanState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Error}">
                                <TextBlock Text="{Binding ScanError}" TextWrapping="Wrap" />
                                <Button Content="{DynamicResource Scan.Again}" Command="{Binding ScanAgainCommand}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel MaxWidth="560" HorizontalAlignment="Left"
                                        Visibility="{Binding NothingFound, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding NothingFoundTitle}" Style="{DynamicResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Scan.NothingBody}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button Content="{DynamicResource Scan.Again}" Command="{Binding ScanAgainCommand}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>

                            <DockPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Scan.Again}"
                                            Command="{Binding ScanAgainCommand}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                    <TextBlock Text="{DynamicResource Scan.FoundIntro}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False" IsEnabled="{Binding IsIdle}">
                                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DataGroupViewModel}">
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="{Binding Label}" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DataItemViewModel}">
                                                                <Border BorderThickness="0,0,0,1" Padding="0,8,0,8"
                                                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- The whole text is the checkbox label, so clicking a path ticks it. -->
                                                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanSelect}"
                                                                                  AutomationProperties.Name="{Binding Path}"
                                                                                  VerticalAlignment="Top" VerticalContentAlignment="Top">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource PathText}" />
                                                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource SecondaryText}"
                                                                                           FontSize="12.5" Margin="0,3,0,0" />
                                                                                <TextBlock Text="{Binding Warning}" Style="{StaticResource CautionText}"
                                                                                           FontSize="12.5" Margin="0,2,0,0"
                                                                                           Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVisibility}}" />
                                                                                <TextBlock Text="{DynamicResource Item.NeedsAdmin}" Style="{StaticResource CautionText}"
                                                                                           FontSize="12.5" Margin="0,2,0,0"
                                                                                           Visibility="{Binding ShowNeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                                                            </StackPanel>
                                                                        </CheckBox>

                                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="16,1,0,0"
                                                                                   VerticalAlignment="Top" HorizontalAlignment="Right" />

                                                                        <Button Grid.Column="2" Content="{DynamicResource Item.Open}"
                                                                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                AutomationProperties.Name="{Binding OpenLabel}"
                                                                                ToolTip="{Binding OpenLabel}"
                                                                                Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}"
                                                                                VerticalAlignment="Top" Margin="12,0,0,0" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Backups tab -->
            <TabItem Header="{DynamicResource Tab.Backups}">
                <DockPanel Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Top" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Backups.Intro}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Backups.Folder}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding BackupsFolder, Mode=OneWay}" FontFamily="{StaticResource PathFont}" FontSize="12.5" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{DynamicResource Backups.OpenFolder}" Command="{Binding OpenFolderCommand}"
                                    CommandParameter="{Binding BackupsFolder}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Backups.Refresh}" Command="{Binding RefreshBackupsCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ContentControl DockPanel.Dock="Top" Focusable="False" MaxWidth="760" HorizontalAlignment="Left"
                                    Content="{Binding RestoreResult}" ContentTemplate="{StaticResource ResultTemplate}"
                                    Visibility="{Binding RestoreResult, Converter={StaticResource NotEmptyToVisibility}}" />

                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding ProgressMaximum}" Height="4" />
                        <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Visibility="{Binding BackupsState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Loading}">
                            <ProgressBar IsIndeterminate="True" Height="4" MaxWidth="760" />
                            <TextBlock Text="{DynamicResource Backups.Loading}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding BackupsState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Error}">
                            <TextBlock Text="{Binding BackupsError}" TextWrapping="Wrap" />
                            <Button Content="{DynamicResource Apps.Retry}" Command="{Binding RefreshBackupsCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel MaxWidth="560" HorizontalAlignment="Left"
                                    Visibility="{Binding NoBackups, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Backups.EmptyTitle}" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{DynamicResource Backups.EmptyBody}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Backups}" Focusable="False" MaxWidth="760" HorizontalAlignment="Left">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BackupItemViewModel}">
                                        <Border BorderThickness="0,0,0,1" Padding="0,10"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{DynamicResource Backups.NeedsAdmin}" Style="{StaticResource CautionText}"
                                                               Margin="0,2,0,0" FontSize="12.5"
                                                               Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource Backups.Restore}"
                                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Margin="0,0,8,0" />
                                                    <Button Content="{DynamicResource Backups.OpenOne}"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Info.Folder}" Margin="0,0,8,0" />
                                                    <Button Content="{DynamicResource Backups.Delete}"
                                                            Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
